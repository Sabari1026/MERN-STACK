# ==============================================================================
# HIRECONNECT FRONTEND CONFIGURATION (.env.example)
# ==============================================================================
# Public API base URL for communicating with the HireConnect backend.
# In local development with Vite dev proxy, leave as /api or http://localhost:5000/api.
# In production, set to your production API endpoint (e.g. https://api.hireconnect.io/api).
# Note: NEVER place secret credentials, database URIs, or private keys in frontend env files.
# ==============================================================================

VITE_API_BASE_URL=http://localhost:5000/api
