# ==============================================================================
# HIRECONNECT FRONTEND CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env for local frontend development or set these variables
# in your deployment platform (e.g. Vercel, Netlify, Cloudflare Pages, AWS Amplify).
#
# IMPORTANT: Never place database credentials, JWT secrets, email API keys,
# or private storage credentials in frontend environment variables.
# ==============================================================================

# Backend API Base URL
# - Local development with separate ports: http://localhost:5000/api
# - Same-origin production or reverse proxy (e.g. Nginx, Cloudflare): /api
# - Dedicated backend domain: https://api.hireconnect.io/api
VITE_API_BASE_URL=/api
