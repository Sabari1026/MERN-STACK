":19,"text":50,"spans":51,"direction":22},"Hook",[],{"link_type":40},{"item_image":54,"item_title":59,"item_video":63},{"dimensions":55,"alt":5,"copyright":5,"url":56,"id":57,"edit":58},{"width":27,"height":28},"https://images.prismic.io/blueprint/aP_ODbpReVYa3uaz_DjCity.jpg?auto=format,compress","aP_ODbpReVYa3uaz",{"x":32,"y":32,"zoom":33,"background":34},[60],{"type":19,"text":61,"spans":62,"direction":22},"DJCity",[],{"link_type":40},"SkillScreen™: Rigorous candidate vetting for technical excellence and team fit",[66,69,72,74],{"type":19,"text":67,"spans":68,"direction":22},"We evaluate every candidate through a comprehensive 3-step process covering technical depth, communication, and culture fit.",[],{"type":19,"text":70,"spans":71,"direction":22},"",[],{"type":19,"text":70,"spans":73,"direction":22},[],{"type":19,"text":75,"spans":76,"direction":22},"Only top candidates make it through—so recruiters and companies connect with professionals they can trust to deliver.",[],"Screening","Inside Our 3-Step Vetting Process",[80,100,116],{"item_title":81,"item_description":82,"item_content":86},"Communication & Culture Alignment",[83],{"type":19,"text":84,"spans":85,"direction":22},"We evaluate what makes great teammates: communication clarity, problem-solving mindset, and alignment with company values.",[],[87,91,94,97],{"type":88,"text":89,"spans":90,"direction":22},"list-item","Clear explanations and active listening",[],{"type":88,"text":92,"spans":93,"direction":22},"Collaborative mindset and team alignment",[],{"type":88,"text":95,"spans":96,"direction":22},"Integrity, transparency, and low-ego approach",[],{"type":88,"text":98,"spans":99,"direction":22},"Ownership, leadership, and self-drive",[],{"item_title":101,"item_description":102,"item_content":106},"Technical & MERN Architecture Evaluation",[103],{"type":19,"text":104,"spans":105,"direction":22},"Senior engineers and technical recruiters evaluate coding proficiency, architecture, and code quality in real time.",[],[107,110,113],{"type":88,"text":108,"spans":109,"direction":22},"Hands-on MERN and full-stack coding challenges",[],{"type":88,"text":111,"spans":112,"direction":22},"Algorithmic problem-solving and clean code standards",[],{"type":88,"text":114,"spans":115,"direction":22},"Depth of system architecture and API design",[],{"item_title":117,"item_description":118,"item_content":122},"Recruiter & Company Alignment Interview",[119],{"type":19,"text":120,"spans":121,"direction":22},"We evaluate delivery ownership, product impact, and direct alignment with hiring company roadmaps.",[],[123,126,129,132],{"type":88,"text":124,"spans":125,"direction":22},"System design and architectural scalability",[],{"type":88,"text":127,"spans":128,"direction":22},"Adaptability and rapid learning capacity",[],{"type":88,"text":130,"spans":131,"direction":22},"Delivery focus under agile sprint deadlines",[],{"type":88,"text":133,"spans":134,"direction":22},"Direct alignment with hiring company objectives",[],"Partnership","How we work with you",[138,144,150],{"item_title":139,"item_description":140},"1st Step",[141],{"type":19,"text":142,"spans":143,"direction":22},"We start by understanding your hiring requirements — from technical stacks and role levels, to company culture and candidate experience.",[],{"item_title":145,"item_description":146},"2nd Step",[147],{"type":19,"text":148,"spans":149,"direction":22},"From there, our platform matches verified candidates who have passed our rigorous skill and profile evaluation.",[],{"item_title":151,"item_description":152},"3nd Step",[153],{"type":19,"text":154,"spans":155,"direction":22},"We support the full recruitment process from initial interview to offer acceptance and long-term placement retention.",[],"Core Tech & Frameworks","Specialized in modern MERN-stack, cloud, and full-stack engineering.",[159,167],{"item_logo":160,"item_title":166},{"dimensions":161,"alt":5,"copyright":5,"url":163,"id":164,"edit":165},{"width":162,"hei