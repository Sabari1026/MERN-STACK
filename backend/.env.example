# ==============================================================================
# HIRECONNECT BACKEND CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to backend/.env and supply the required values for your environment.
# Never commit the actual .env file or real production credentials to Git.
#
# HOW TO GENERATE STRONG PRODUCTION SECRETS:
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# Server port (default: 5000)
PORT=5000

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Trust reverse-proxy headers (X-Forwarded-For) behind AWS ALB, Cloudflare, Render, Railway, Nginx
# Set to 'true' in production behind an SSL terminating reverse proxy.
TRUST_PROXY=false

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/hireconnect
# Hosted MongoDB (e.g. MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/hireconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hireconnect

# Allowed Frontend URL(s) for CORS. Can be comma-separated for multiple origins.
# Vite dev: http://localhost:5173
# Local server: http://localhost:3000
# Production: https://hireconnect.io,https://www.hireconnect.io
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Authentication & Security Secrets
# In production, MUST be unique, randomly generated strings (min 32 characters).
# The application will refuse to start in production if the dev defaults are retained.
JWT_SECRET=hireconnect-dev-super-secure-jwt-secret-key-32chars+
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=hireconnect-dev-cookie-secret-key-32chars+
# Cookie SameSite attribute ('lax' for same-site / reverse-proxy, 'none' for cross-domain HTTPS)
COOKIE_SAME_SITE=lax

# Background Worker Toggle
# When running multiple web server instances behind a load balancer, set to 'false'
# on web nodes and run a dedicated worker instance using: npm run worker:reminders
ENABLE_BACKGROUND_WORKER=true

# Storage Configuration
# Storage driver: 'local' (persistent disk mount) or 's3' (AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER=local
# Local persistent directory for avatars and private candidate resumes
# In production with Docker, Render Persistent Disks, or VPS, mount a persistent volume at this path:
UPLOAD_DIR=./uploads

# Optional Amazon S3 / Cloudflare R2 / MinIO Object Storage (Required only if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# Google OAuth 2.0 Credentials (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Transactional Email & Notifications (Phase 9)
# Genuine SMTP provider (e.g. Resend, SendGrid, Amazon SES, Mailgun, Brevo)
# When omitted, system safely logs emails without dropping database notifications.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
EMAIL_FROM=HireConnect <onboarding@resend.dev>
EMAIL_FROM_NAME="HireConnect Team"
# Set to 'true' in automated test/dev pipelines to capture emails in memory:
# SANDBOX_EMAIL=false

# Password Reset URL
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Platform Administrator Bootstrap (CLI)
# Used by `npm run bootstrap:admin` to initialize the primary platform administrator.
# In production, set a strong, unique administrative password (min 10 characters).
ADMIN_BOOTSTRAP_EMAIL=admin@hireconnect.io
ADMIN_BOOTSTRAP_PASSWORD=Admin@123
ADMIN_BOOTSTRAP_NAME="Super Administrator"
